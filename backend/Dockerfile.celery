# syntax=docker/dockerfile:1.7
# Celery worker — identical venv to backend, different entrypoint

FROM ghcr.io/astral-sh/uv:0.4.20 AS uv

FROM python:3.12-slim AS deps
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libpq-dev gcc && \
    rm -rf /var/lib/apt/lists/*
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_CACHE_DIR=/root/.cache/uv UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
COPY pyproject.toml uv.lock* ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-editable 2>/dev/null || \
    uv sync --no-dev --no-editable

FROM python:3.12-slim AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends libpq5 && \
    rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:$PATH" PYTHONPATH="/app"
RUN addgroup --system app && adduser --system --ingroup app --no-create-home app
COPY --from=deps --chown=app:app /app/.venv /app/.venv
COPY --chown=app:app . .
USER app

# --without-heartbeat/gossip/mingle: reduces broker traffic on single-broker deployments
CMD ["celery", \
     "-A", "app.workers.ingestion_worker.celery_app", \
     "worker", \
     "--loglevel=info", \
     "--concurrency=2", \
     "--without-heartbeat", \
     "--without-gossip", \
     "--without-mingle", \
     "--max-tasks-per-child=100"]
