ENVIRONMENT=development
LOG_LEVEL=INFO

POSTGRES_USER=triage_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=triage_db
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_POOL_MAX_WAITING=20
DB_POOL_MAX_IDLE=300.0

REDIS_URL=redis://redis:6379/0

OPENAI_API_KEY=sk-...
FINE_TUNED_MODEL_ID=ft:gpt-4o-mini:your-org:triage:xxxxx

JWT_SECRET_KEY=replace-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

INTERNAL_API_KEY=replace-with-random-secret
BACKEND_URL=http://backend:8000

LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=600
MAX_MESSAGE_CHARS=2000
MAX_INPUT_TOKENS=400

RAG_MIN_SIMILARITY=0.72
RAG_TOP_K=5
RAG_FETCH_K=20
RAG_LAMBDA_MULT=0.6

MAX_CONTEXT_TURNS=4

# OpenTelemetry (gRPC OTLP endpoint)
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel_collector:4317
OTEL_SERVICE_NAME=medical-triage-backend
