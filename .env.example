# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_USER=triage_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=triage_db
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Connection pool
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_POOL_MAX_WAITING=20
DB_POOL_MAX_IDLE=300.0

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
FINE_TUNED_MODEL_ID=ft:gpt-4o-mini:your-org:triage:xxxxx
MODEL_VERSION=1.0.0

# ── Auth — generate secrets with: openssl rand -hex 32 ────────────────────────
JWT_SECRET_KEY=replace-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Internal service auth ──────────────────────────────────────────────────────
INTERNAL_API_KEY=replace-with-random-secret
BACKEND_URL=http://backend:8000

# ── Observability ─────────────────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel_collector:4317
OTEL_SERVICE_NAME=medical-triage-backend

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=600

# ── Input constraints ─────────────────────────────────────────────────────────
MAX_MESSAGE_CHARS=2000
MAX_INPUT_TOKENS=400
MAX_CONTEXT_TURNS=4

# ── RAG ───────────────────────────────────────────────────────────────────────
RAG_MIN_SIMILARITY=0.72
RAG_TOP_K=5
RAG_FETCH_K=20
RAG_LAMBDA_MULT=0.6

# ── Next.js frontend ──────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Drizzle (BFF DB — same Postgres instance) ─────────────────────────────────
# Note: Drizzle uses the raw postgresql:// URL (no +psycopg driver prefix)
# DATABASE_URL above also works if you strip the +psycopg part:
# DATABASE_URL=postgresql://triage_user:changeme@postgres:5432/triage_db
